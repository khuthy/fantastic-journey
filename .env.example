# Protea Glen Gate Access — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit the .env file.

# Your edge/serverless API that wraps Neon Postgres
NEON_API_URL=https://api.proteaglen.example.com

# Cloudflare R2 (credentials stay server-side; only the API URL is needed client-side)
# R2 presigned URL requests go through your API, not directly to R2.

# Push notifications (optional — FCM / APNs handled server-side)
# FCM_SERVER_KEY=...
